<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/wear_app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WearApp">

        <!-- Standalone Wear OS flag required for Google Play Wear OS track -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <!-- Main Wear OS Activity / Wrist Pacer -->
        <activity
            android:name=".wear.WearMainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/Theme.WearApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Wear OS Tile Service -->
        <service
            android:name=".wear.RotationTileService"
            android:exported="true"
            android:label="@string/tile_name"
            android:description="@string/tile_description"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview" />
        </service>

        <!-- Google Play Services Wearable Listener Service (Syncs schedule from phone) -->
        <service
            android:name=".wear.WearScheduleListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/rotation_schedule"
                    android:scheme="wear" />
            </intent-filter>
        </service>

    </application>

</manifest>
