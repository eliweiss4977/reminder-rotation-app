<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wear_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp">

        <!-- Header: Next Rotation Time & Profile -->
        <TextView
            android:id="@+id/wear_label_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NEXT ROTATION"
            android:textColor="@color/wear_slate_light"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/wear_next_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="02:00 PM"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/wear_profile_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="(Standard 10-Day Block)"
            android:textColor="#A5B4FC"
            android:textSize="10sp"
            android:layout_marginTop="1dp" />

        <!-- 40x Circular Pacer Tap Target -->
        <FrameLayout
            android:id="@+id/wear_pacer_circle"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/wear_pacer_circle_bg"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/wear_pacer_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#34D399"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/wear_pacer_target"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="of 40"
                    android:textColor="@color/wear_slate_light"
                    android:textSize="10sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Status / Instruction -->
        <TextView
            android:id="@+id/wear_pacer_instruction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Tap circle to count rotations"
            android:textColor="@color/wear_slate_light"
            android:textSize="10sp"
            android:gravity="center" />

        <!-- Auto-Pacer Button -->
        <Button
            android:id="@+id/wear_btn_auto_pacer"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/wear_btn_primary"
            android:text="Start Auto-Pacer ▶"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textAllCaps="false"
            android:textStyle="bold" />

        <!-- Reset Button -->
        <Button
            android:id="@+id/wear_btn_reset"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/wear_btn_secondary"
            android:text="Reset Count"
            android:textColor="@color/wear_slate_light"
            android:textSize="10sp"
            android:textAllCaps="false" />

    </LinearLayout>
</ScrollView>
